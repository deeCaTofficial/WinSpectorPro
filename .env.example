# API key for Google Gemini AI.
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="ВАШ_API_КЛЮЧ_ЗДЕСЬ"

# Необязательно: модель Gemini (по умолчанию gemini-3.8-flash).
# Модели 2.5 Google открывает только тем, кто уже пользовался ими раньше.
# GEMINI_MODEL="gemini-3.5-flash-lite"

# Необязательно: уровень логирования (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL="INFO"
